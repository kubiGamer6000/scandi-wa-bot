# --- Logging ---
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Database (Supabase / Postgres) ---
# Get this from: Supabase project → Settings → Database → Connection string
# → "Transaction pooler" tab, URI format. The bot will hard-fail on startup
# if this is missing or unreachable. Keep this secret — it grants full DB access.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Account label used to scope every row in the wa.* tables. Stable identifier
# for *this* WhatsApp account — change only if you intentionally want to
# isolate data. Multiple bots can share one DB with different labels.
WA_ACCOUNT_LABEL=default

# --- Auth state ---
# The bot persists session credentials & signal keys in Postgres
# (wa.auth_creds and wa.auth_keys). AUTH_DIR is now LEGACY: it is only
# read once on first boot to import a pre-existing useMultiFileAuthState
# folder into the DB. After import the folder is renamed to
# data/auth.migrated-<ts>/. New installs can leave this at the default.
AUTH_DIR=data/auth

# --- Connection ---
# Browser identity sent to WhatsApp. Common values: "Ubuntu", "macOS", "Windows".
# Pick one that matches the host you run on.
BROWSER_PLATFORM=Ubuntu

# Use "Desktop" as the browser NAME to unlock deep history sync (per Baileys docs).
# The pretty display in WhatsApp's "Linked devices" list is BROWSER_PLATFORM + BROWSER_NAME.
BROWSER_NAME=Desktop

# When true, Baileys requests the full multi-year history from your phone after
# pairing. Required for the message store to back-fill historical chats.
SYNC_FULL_HISTORY=true

# Whether to mark the linked device as online on connect.
# Set to "false" if you also use WhatsApp on your phone and want push
# notifications to keep arriving on the phone.
MARK_ONLINE_ON_CONNECT=false

# --- Behaviour ---
# Comma-separated list of JIDs the bot is allowed to send messages to in tests
# (leave empty to allow any). Useful while developing.
# Example: 12345678901@s.whatsapp.net,9876543210@s.whatsapp.net
ALLOWED_JIDS=

# ─────────────────────────── Read receipts ───────────────────────────
# The bot acknowledges every LIVE inbound message in DMs and groups, so chats
# don't sit unread. History-sync backfill is never acknowledged.
#
# NOTE: WhatsApp downgrades the ack to "read-self" (no blue ticks for the
# sender) when the linked account has read receipts switched off. The bot logs
# a warning on connect if it detects that; fix it on the paired phone under
# Settings → Privacy → Read receipts.

# Master switch. Default: on.
# READ_RECEIPTS_ENABLED=true

# Restrict receipts to specific chats. Default "*" = every DM and group.
# READ_RECEIPTS_JIDS=12345678901@s.whatsapp.net,120363012345678901@g.us

# Randomised think-time before a batch of receipts goes out, so acks don't
# land the same millisecond the message did.
# READ_RECEIPTS_DELAY_MIN_MS=600
# READ_RECEIPTS_DELAY_MAX_MS=2500

# Keys per readMessages() call, and the floor between two flushes.
# READ_RECEIPTS_BATCH_SIZE=25
# READ_RECEIPTS_MIN_INTERVAL_MS=750

# ─────────────────────────── Typing indicators ───────────────────────────
# Consumers open a typing session via POST /v1/chats/:jid/typing while they
# work on a reply; the bot keeps the WhatsApp chatstate alive until the
# session's TTL lapses, the consumer closes it, or the bot sends a message to
# that chat. See docs/API.md §6.7.

# Master switch for the typing endpoints. Default: on.
# TYPING_ENABLED=true

# Refresh cadence + jitter. WhatsApp expires an indicator after ~10s, so this
# is clamped to 3000-9000ms; the jitter keeps the cadence from looking
# metronomic.
# TYPING_REFRESH_MS=7500
# TYPING_REFRESH_JITTER_MS=1200

# Default and maximum session lifetime a caller may request, plus a hard cap
# on one session however often it's re-asserted.
# TYPING_TTL_MS=120000
# TYPING_MAX_TTL_MS=300000
# TYPING_MAX_SESSION_MS=900000

# How many chats may show "typing…" simultaneously. A human doesn't type in
# ten conversations at once.
# TYPING_MAX_CONCURRENT_CHATS=10

# Flip global presence to "available" while typing. Off by default: going
# online suppresses push notifications on the paired phone, and typing
# indicators work fine without it.
# TYPING_MARK_AVAILABLE=false

# --- Media storage (Firebase Storage / Google Cloud Storage) ---
# When FIREBASE_STORAGE_BUCKET is set, the bot decrypts every incoming media
# payload (image / video / audio / document / sticker / ptv / gif) and uploads
# the original bytes to the bucket. The wa.media table acts as a Postgres-backed
# work queue (FOR UPDATE SKIP LOCKED) with retries, leases, and crash recovery.

# Bucket name *without* the gs:// prefix.
# Find it in Firebase Console → Storage → "gs://<bucket-name>".
# Modern projects use ".firebasestorage.app", older ones use ".appspot.com".
FIREBASE_STORAGE_BUCKET=

# Path to a service account JSON file with the "Storage Admin" role.
# Generate one in Firebase Console → Project Settings → Service accounts → Generate new private key.
# Alternatively set FIREBASE_SERVICE_ACCOUNT_JSON to the raw JSON, or rely on
# Application Default Credentials via GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_PROJECT_ID=

# Master switch. Defaults to ON if FIREBASE_STORAGE_BUCKET is set.
# MEDIA_DOWNLOAD_ENABLED=true

# Allow-list of media types. Comma-separated, default covers all.
# MEDIA_TYPES=image,video,audio,document,sticker,ptv,gif

# Skip a single media if its declared file_length exceeds this many bytes.
# Default 100 MiB.
# MEDIA_MAX_BYTES=104857600

# Worker tuning.
# MEDIA_DOWNLOAD_CONCURRENCY=3      # parallel downloads
# MEDIA_DOWNLOAD_BATCH_SIZE=10      # rows claimed per poll
# MEDIA_DOWNLOAD_POLL_MS=5000       # idle poll interval; ignored when notified
# MEDIA_LEASE_SECONDS=120           # how long a row stays "in_progress" before reaper takes over
# MEDIA_MAX_ATTEMPTS=6              # rows past this many transient failures get marked 'failed'

# --- AI processing (post-download analysis) ---
# After media is uploaded to Firebase Storage, the processing worker sends it
# to AI services for description/transcription/parsing. Each service is
# activated by providing its API key; no key = that media type is skipped.

# Gemini — video + image analysis. Uses gs:// URI directly (no re-download).
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model for both video and image. Default: gemini-2.5-flash
# PROCESSING_MODEL_VIDEO=gemini-2.5-flash
# Images/stickers. Defaults to the video model; a Flash model answers in ~4s
# where a Pro model takes ~20s, and a reply to an image waits on this.
# PROCESSING_MODEL_IMAGE=gemini-3.8-flash

# ElevenLabs Scribe — audio transcription. Downloads bytes from GCS.
# Get a key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# PROCESSING_MODEL_AUDIO=scribe_v2

# LlamaParse — document-to-markdown (PDF, DOCX, XLSX, CSV, etc.). Downloads bytes from GCS.
# Get a key from: https://cloud.llamaindex.ai/api-key
LLAMA_CLOUD_API_KEY=
# PROCESSING_LLAMAPARSE_TIER=agentic    # fast, cost_effective, agentic, agentic_plus

# Master switch. Defaults to ON if any API key above is set.
# PROCESSING_ENABLED=true

# Custom prompts (override the defaults in src/store/processing/prompts.ts).
# PROCESSING_PROMPT_VIDEO="Provide a full timestamped visual description..."
# PROCESSING_PROMPT_IMAGE="Describe this image in detail..."

# Worker tuning (processing is slower/more expensive than downloads).
# PROCESSING_CONCURRENCY=4       # parallel AI calls (slots refill as each finishes)
# PROCESSING_BATCH_SIZE=5        # rows claimed per poll
# PROCESSING_POLL_MS=10000       # idle poll interval (10s)
# PROCESSING_LEASE_SECONDS=600   # 10-minute lease (AI calls are slow)
# PROCESSING_MAX_ATTEMPTS=4      # backoff: 1m, 5m, 30m, 2h

# ─────────────────────────── HTTP API layer ───────────────────────────
# An in-process Fastify server exposing chat reads, send/edit/react/delete,
# webhook subscription CRUD, and media fetch. Secured by a single bearer
# token. Bind to 127.0.0.1 in production and reverse-proxy via Nginx/Caddy.

# Master switch. When true, API_AUTH_TOKEN is REQUIRED — the bot refuses
# to start an unauthenticated API.
API_ENABLED=false

# Bearer token clients must send in the `Authorization: Bearer ...` header.
# Generate one with: openssl rand -hex 32
API_AUTH_TOKEN=

# Bind address + port. Default: 127.0.0.1:8787.
# API_HOST=127.0.0.1
# API_PORT=8787

# Cap on inbound request body size (MB). Multipart uploads share this limit.
# API_MAX_BODY_MB=25

# ─────────────────────────── Webhook delivery worker ───────────────────────────
# A second Postgres-backed queue (wa.webhook_deliveries). Drains in parallel
# via FOR UPDATE SKIP LOCKED with exponential backoff. Subscriptions are
# managed via POST /v1/webhooks (DB-stored, hot-swappable).

# WEBHOOK_CONCURRENCY=4          # parallel outbound POSTs
# WEBHOOK_BATCH_SIZE=10          # rows claimed per poll
# WEBHOOK_POLL_MS=5000           # idle poll interval (5s)
# WEBHOOK_LEASE_SECONDS=60       # row lease
# WEBHOOK_MAX_ATTEMPTS=6         # backoff: 30s, 2m, 10m, 1h, 6h, 24h
# WEBHOOK_TIMEOUT_MS=10000       # per-request HTTP timeout
